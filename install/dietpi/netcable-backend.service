[Unit]
Description=NetCable backend (FastAPI)
After=network.target

[Service]
Type=simple
User=dietpi
WorkingDirectory=/home/dietpi/netcable/backend
EnvironmentFile=/home/dietpi/netcable/.env
ExecStart=/home/dietpi/netcable/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
